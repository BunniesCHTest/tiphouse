{
  "name": "tiphouse",
  "private": true,
  "version": "1.0.0",
  "description": "Production-ready TipHouse donate platform monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo Use npm run dev:backend and npm run dev:frontend in separate terminals",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "build": "npm run build -w packages/types && npm run build -w apps/backend && npm run build -w apps/frontend",
    "lint": "npm run lint -w apps/backend && npm run lint -w apps/frontend",
    "db:migrate": "npm run prisma:migrate -w apps/backend",
    "db:seed": "npm run prisma:seed -w apps/backend"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/platform-socket.io": "11.1.27",
    "@nestjs/websockets": "11.1.27",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "multer": "2.2.0",
    "postcss": "8.5.10",
    "qs": "6.15.3",
    "ws": "8.21.0"
  }
}
