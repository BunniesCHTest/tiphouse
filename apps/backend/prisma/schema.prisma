generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  ACCOUNTING
}

enum AccountStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ApprovalType {
  REGISTER
  EMAIL_CHANGE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  REVIEW
  EXPIRED
}

enum PaymentProvider {
  PROMPTPAY
  OMISE
  GBPRIMEPAY
  STRIPE
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  role         UserRole       @default(USER)
  accountStatus AccountStatus @default(PENDING)
  pendingEmail String?
  twoFaSecret  String?
  passwordMustChange Boolean @default(false)
  creatorSetupCompleted Boolean @default(false)
  donationNotificationEmail String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  page         DonationPage?
  donations    Donation[]
  payout       PayoutAccount?
  overlay      OverlaySetting?
  approvals    ApprovalRequest[]
  passwordResets PasswordResetToken[]
  adminLogs    AdminLog[]     @relation("AdminLogs")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  userId        String
  type          ApprovalType
  status        ApprovalStatus @default(PENDING)
  requestedEmail String?
  note          String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model DonationPage {
  id          String     @id @default(uuid())
  userId      String     @unique
  slug        String     @unique
  displayName String
  handle      String
  avatarUrl   String?
  bannerUrl   String?
  soundUrl    String?
  donationAccountName String @default("TipHouse Creator")
  theme       Json       @default("{}")
  minAmount   Int        @default(20)
  goalAmount  Int        @default(5000)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations   Donation[]
}

model Donation {
  id              String          @id @default(uuid())
  userId          String
  pageId          String
  donorName       String
  message         String
  amount          Int
  anonymous       Boolean         @default(false)
  paymentStatus   DonationStatus  @default(PENDING)
  paymentProvider PaymentProvider
  transactionRef  String?         @unique
  providerTransactionId String?   @unique
  qrPayload       String?
  expiresAt       DateTime?
  verifiedAt      DateTime?
  slipTransactionRef String?      @unique
  slipVerification Json?
  paidAt          DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  page            DonationPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([paymentStatus, createdAt])
}

model OverlaySetting {
  id            String   @id @default(uuid())
  userId        String   @unique
  streamerKey   String   @unique @default(uuid())
  animation     Json     @default("{}")
  soundUrl      String?
  ttsEnabled    Boolean  @default(true)
  theme         Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayoutAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  accountName   String?
  legalName     String?
  phone         String?
  contactEmail  String?
  taxId         String?
  address       String?
  bankName      String?
  branchName    String?
  accountType   String?
  accountNumber String?
  payoutMethod  String   @default("BANK_TRANSFER")
  promptpayType String?
  promptpayId   String?
  receivingQrImageUrl String?
  receivingQrPayload String?
  slipOkBranchId String?
  slipOkApiKeyEncrypted String?
  note          String?
  kycStatus     String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookLog {
  id          String   @id @default(uuid())
  provider    String
  eventType   String
  signatureOk Boolean
  payload     Json
  createdAt   DateTime @default(now())
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  targetId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  admin     User     @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)
}
