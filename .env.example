NODE_ENV=production
DOMAIN=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

POSTGRES_DB=tiphouse
POSTGRES_USER=tiphouse
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://tiphouse:change-me@postgres:5432/tiphouse?schema=public

REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-64-random-chars
JWT_REFRESH_SECRET=replace-with-another-64-random-chars
ADMIN_2FA_ISSUER=TipHouse

OMISE_PUBLIC_KEY=pkey_test_xxx
OMISE_SECRET_KEY=skey_test_xxx
OMISE_WEBHOOK_SECRET=whsec_xxx
GBPRIMEPAY_MERCHANT_ID=
GBPRIMEPAY_SECRET=
STREAMLABS_CLIENT_ID=
STREAMLABS_CLIENT_SECRET=
STREAMLABS_REDIRECT_URI=https://api.yourdomain.com/api/auth/streamlabs/callback

# Raw payload decoded from the receiving account's existing Thai QR.
# Keep this value in the deployment environment only; do not commit a real value.
PAYMENT_QR_BASE_PAYLOAD=
# Separate secret used to encrypt each creator's SlipOK API key at rest.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters
# Development only. Never enable this in production.
SLIPOK_MOCK_MODE=false

S3_ENDPOINT=https://s3.your-provider.com
S3_REGION=auto
S3_BUCKET=tiphouse-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
